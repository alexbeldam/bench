#!/bin/bash
# Starts the search process with the arguments the container runner passes. When FL_MONGOT_ADDR is set, the
# mongod address it connects to is replaced by that value (for a proxy in the container's network namespace).
args=()
for a in "$@"; do
  if [ "$a" = "localhost:27017" ] && [ -n "${FL_MONGOT_ADDR:-}" ]; then a="$FL_MONGOT_ADDR"; fi
  args+=("$a")
done
exec -a /opt/mongot/bin/jdk/bin/java /opt/mongot/bin/jdk/bin/java.real "${args[@]}"
